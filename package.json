{
	"name": "responsive-visibility",
	"version": "1.2.2",
	"description": "Responsive Visibility build pipeline",
	"author": "wowDevs",
	"license": "GPL-2.0-or-later",
	"private": true,
	"packageManager": "pnpm@10.14.0",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"ship": "bash scripts/publish.sh",
		"release": "bash scripts/release.sh",
		"release:check": "php -l responsive-visibility.php && find includes -name '*.php' -print0 | xargs -0 -n1 php -l && pnpm zip",
		"zip": "node scripts/zip.js",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@wordpress/scripts": "^27.9.0"
	},
	"dependencies": {
		"classnames": "^2.5.1"
	}
}
